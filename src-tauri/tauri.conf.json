{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyrc",
  "version": "0.1.0",
  "identifier": "com.baiyuechu.keyrc",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "keyrc",
        "width": 300,
        "height": 104,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "focus": false
      }
    ],

    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/keyboard-clean-tool.png",
      "icons/Keyboard_Clean_Tool_jmMVCSviVI_icns-904ca4b896.icns",
      "icons/icon.ico"
    ]
  }
}
